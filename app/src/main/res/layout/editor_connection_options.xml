<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogConnectionOptions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="连接状态"
        android:textColor="@color/text_title"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/dialogConnectionMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_spinner"
        android:minHeight="52dp"
        android:spinnerMode="dropdown" />

    <TextView
        android:id="@+id/dialogConnectionSourceLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="已保存的 Wi-Fi"
        android:textColor="@color/text_title"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/dialogConnectionSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_spinner"
        android:minHeight="52dp"
        android:spinnerMode="dropdown" />

    <TextView
        android:id="@+id/dialogConnectionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogConnectionSettings"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="系统设置" />

        <ImageButton
            android:id="@+id/dialogConnectionRefresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="刷新列表"
            android:tooltipText="刷新列表"
            android:src="@android:drawable/ic_popup_sync"
            app:tint="@color/text_title" />
    </LinearLayout>
</LinearLayout>
