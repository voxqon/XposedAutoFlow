<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogTimerOptions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical"
    android:visibility="gone">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialogTimerTime"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:text="@string/timer_time_value_default"
        app:cornerRadius="8dp"
        app:icon="@android:drawable/ic_menu_recent_history" />

    <RadioGroup
        android:id="@+id/dialogTimerDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/dialogTimerEveryDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/timer_every_day" />

        <RadioButton
            android:id="@+id/dialogTimerWeekdays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/timer_weekdays" />

        <RadioButton
            android:id="@+id/dialogTimerWeekends"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/timer_weekends" />

        <RadioButton
            android:id="@+id/dialogTimerWorkdays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/timer_workdays" />

        <RadioButton
            android:id="@+id/dialogTimerHolidays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/timer_holidays" />
    </RadioGroup>
</LinearLayout>
